local function ZDPVSPH_fake_script() -- itemFrame.LocalScript 
	local script = Instance.new('LocalScript', itemFrame)

	-- LocalScript
	
	local root = script.Parent.Parent
	
	local itemFrame = root:WaitForChild("itemFrame")
	local searchButton = root:WaitForChild("searchButton")
	local searchSource = root:WaitForChild("Dropdown"):WaitForChild("MainButton")
	
	-- Clear previous results
	local function clearResults()
		for _, child in ipairs(itemFrame:GetChildren()) do
			if child:IsA("TextBox") then
				child:Destroy()
			end
		end
	end
	
	-- Create a result textbox
	local function createResult(text)
		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, 0, 0, 16)
		box.BackgroundColor3 = Color3.fromRGB(56, 56, 56)
		box.BorderSizePixel = 0
		box.TextColor3 = Color3.new(1, 1, 1)
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = Enum.TextYAlignment.Center
		box.TextEditable = false
		box.ClearTextOnFocus = false
		box.Text = text
		box.Parent = itemFrame
		box.Font = Enum.Font.DenkOne
		box.TextScaled = true
	end
	
	-- Run the search
	local function searchWorkspace()
		local searchValue = searchSource.Text
	
		clearResults()
	
		if not searchValue or searchValue == "" then
			return
		end
	
		searchValue = string.lower(searchValue)
	
		for _, inst in ipairs(workspace:GetDescendants()) do
			if string.find(string.lower(inst.Name), searchValue, 1, true) then
				createResult(inst.Name)
			end
		end
	end
	
	-- 🔘 Button hookup
	searchButton.MouseButton1Click:Connect(searchWorkspace)
	
end
coroutine.wrap(ZDPVSPH_fake_script)()
local function VOAV_fake_script() -- Dropdown.LocalScript 
	local script = Instance.new('LocalScript', Dropdown)

	local dropdown = script.Parent
	local mainButton = dropdown.MainButton
	local optionsFrame = dropdown.Options
	
	local open = false
	local optionHeight = 40
	local optionCount = #optionsFrame:GetChildren()
	
	-- Toggle dropdown
	mainButton.MouseButton1Click:Connect(function()
		open = not open
	
		if open then
			optionsFrame:TweenSize(
				UDim2.new(1, 0, 0, optionHeight * optionCount),
				"Out",
				"Quad",
				0.25,
				true
			)
		else
			optionsFrame:TweenSize(
				UDim2.new(1, 0, 0, 0),
				"Out",
				"Quad",
				0.25,
				true
			)
		end
	end)
	
	-- Handle option clicks
	for _, option in pairs(optionsFrame:GetChildren()) do
		if option:IsA("TextButton") then
			option.MouseButton1Click:Connect(function()
				mainButton.Text = option.Text
				open = false
				optionsFrame:TweenSize(
					UDim2.new(1, 0, 0, 0),
					"Out",
					"Quad",
					0.25,
					true
				)
			end)
		end
	end
	print("Hello world!")
	
end
coroutine.wrap(VOAV_fake_script)()
